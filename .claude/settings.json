{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint"
          },
          {
            "type": "command",
            "command": "npm run format"
          },
          {
            "type": "command",
            "command": "npm test"
          },
          {
            "type": "command",
            "command": "npm run test:tsc"
          }
        ]
      }
    ]
  }
}
