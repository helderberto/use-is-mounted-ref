{
  "name": "use-is-mounted-ref",
  "description": "📦 React Hooks for mount state tracking and auto-cleanup with AbortController.",
  "author": "Helder B. Berto <helder.burato@gmail.com> (https://helderberto.com/)",
  "license": "MIT",
  "version": "2.1.2",
  "main": "dist/use-is-mounted-ref.cjs.js",
  "module": "dist/use-is-mounted-ref.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "build": "rm -fr ./dist && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly --noEmit false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "commit": "czg",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "hook",
    "mounted",
    "unmounted",
    "ref",
    "abort",
    "abortcontroller",
    "abortsignal",
    "cleanup",
    "memory-leak",
    "strict-mode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helderberto/use-is-mounted-ref.git"
  },
  "bugs": {
    "url": "https://github.com/helderberto/use-is-mounted-ref/issues"
  },
  "homepage": "https://github.com/helderberto/use-is-mounted-ref#readme",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.5",
    "czg": "1.14.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "terser": "5.51.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "build",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version}"
        }
      ]
    ]
  },
  "type": "commonjs",
  "sideEffects": false
}
