{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "rootDir": "./src",
    "declarationMap": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["es2018", "dom"],
    "noEmit": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2018",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules"]
}
